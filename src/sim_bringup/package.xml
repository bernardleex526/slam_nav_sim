<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_bringup</name>
  <version>0.1.0</version>
  <description>
    顶层编排。一条命令把「世界 + 机器人 + 传感器 + 建图 + 导航 + 可视化 + 指标」
    全串起来，所有变量都是 launch 参数。
  </description>
  <maintainer email="bernard@todo.todo">Bernard</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>sim_worlds</exec_depend>
  <exec_depend>robot_descriptions</exec_depend>
  <exec_depend>mapping_adapters</exec_depend>
  <exec_depend>nav2_config</exec_depend>
  <exec_depend>sim_viz</exec_depend>
  <exec_depend>sim_metrics</exec_depend>
  <exec_depend>robot_interface_spec</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
