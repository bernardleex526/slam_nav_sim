<?xml version="1.0"?>
<robot name="sim_agv" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Generic differential AGV geometry, not a manufacturer-specific vehicle. -->
  <xacro:arg name="body_x" default="0.65"/>
  <xacro:arg name="body_y" default="0.45"/>
  <xacro:arg name="body_z" default="0.20"/>
  <xacro:arg name="body_mass" default="25.0"/>
  <xacro:arg name="wheel_radius" default="0.10"/>
  <xacro:arg name="wheel_width" default="0.05"/>
  <xacro:arg name="sensor_profile" default="lidar3d_imu_cam"/>
  <xacro:arg name="use_gimbal" default="false"/>
  <xacro:arg name="odom_source" default="gt"/>
  <xacro:arg name="lidar_xyz" default="0.0 0.0 0.20"/>
  <xacro:arg name="lidar_rpy" default="0 0 0"/>
  <xacro:arg name="camera_xyz" default="0.30 0.0 0.15"/>
  <xacro:arg name="camera_rpy" default="0 0 0"/>
  <xacro:arg name="imu_xyz" default="0.0 0.0 0.12"/>
  <xacro:arg name="imu_rpy" default="0 0 0"/>
  <xacro:include filename="$(find robot_descriptions)/xacro/common/materials.xacro"/>
  <xacro:include filename="$(find robot_descriptions)/xacro/common/sensors.xacro"/>
  <xacro:include filename="$(find robot_descriptions)/xacro/common/gazebo_control.xacro"/>
  <xacro:property name="bx" value="$(arg body_x)"/>
  <xacro:property name="by" value="$(arg body_y)"/>
  <xacro:property name="bz" value="$(arg body_z)"/>
  <xacro:property name="wr" value="$(arg wheel_radius)"/>
  <xacro:property name="ww" value="$(arg wheel_width)"/>
  <xacro:property name="gimbal" value="$(arg use_gimbal)"/>
  <link name="base_footprint"/>
  <link name="base_link">
    <xacro:sim_box_inertia mass="$(arg body_mass)" size_x="${bx}" size_y="${by}" size_z="${bz}"/>
    <visual><geometry><box size="${bx} ${by} ${bz}"/></geometry><material name="sim_light_grey"/></visual>
    <collision><geometry><box size="${bx} ${by} ${bz}"/></geometry></collision>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wr+bz/2}"/></joint>
  <xacro:macro name="wheel" params="name sign">
    <link name="${name}">
      <xacro:sim_cylinder_inertia mass="1.0" radius="${wr}" length="${ww}"/>
      <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wr}" length="${ww}"/></geometry><material name="sim_dark_grey"/></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wr}" length="${ww}"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/>
      <origin xyz="0 ${sign*(by/2+ww/2)} ${-bz/2}"/></joint>
  </xacro:macro>
  <xacro:wheel name="left_wheel" sign="1"/>
  <xacro:wheel name="right_wheel" sign="-1"/>
  <xacro:macro name="caster" params="name sign">
    <link name="${name}">
      <xacro:sim_box_inertia mass="0.2" size_x="0.08" size_y="0.08" size_z="0.08"/>
      <visual><geometry><sphere radius="0.04"/></geometry><material name="sim_dark_grey"/></visual>
      <collision><geometry><sphere radius="0.04"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="base_footprint"/><child link="${name}"/>
      <origin xyz="${sign*(bx/2-.08)} 0 0.04"/></joint>
  </xacro:macro>
  <xacro:caster name="front_caster" sign="1"/>
  <xacro:caster name="rear_caster" sign="-1"/>
  <xacro:sim_sensor_suite profile="$(arg sensor_profile)" lidar_parent="base_link" lidar_frame="lidar_link"
    lidar_msg_frame="${'lidar_stabilized' if gimbal else ''}"
    lidar_xyz="$(arg lidar_xyz)" lidar_rpy="$(arg lidar_rpy)" camera_xyz="$(arg camera_xyz)"
    camera_rpy="$(arg camera_rpy)" imu_xyz="$(arg imu_xyz)" imu_rpy="$(arg imu_rpy)"/>
  <xacro:sim_kinematic_freeze/>
  <xacro:sim_planar_move odom_source="$(arg odom_source)"/>
  <xacro:sim_ground_truth_odom/>
</robot>
