<?xml version="1.0"?>
<robot name="sim_wheeled_quadruped" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- =========================================================================
       轮足式机器狗参数化模板
       =========================================================================
       对标平台：Unitree Go2W / B2-W / 璇玑动力中狗 等（腿 + 轮 混合构型）
       每腿 3 DOF：髋关节（roll, abduction） + 大腿（pitch） + 轮（continuous）
       共 12 DOF。

       设计要点：
         - 所有尺寸从 xacro arg 进来，由 launch 从 robot_params.yaml 读取。
           想改机器人尺寸不必碰这个文件。
         - 零位姿态 = 腿完全伸展、轮子正好触地。因为默认用 planar_move 驱动，
           腿保持静止即可，不需要步态控制器。
         - /points 的 frame 在启用稳定云台时为 lidar_stabilized（TF 由节点发布），
           否则为 lidar_link。
       ========================================================================= -->

  <!-- ======================== 参数入口 ======================== -->
  <xacro:arg name="robot_name"            default="wheeled_quadruped"/>
  <xacro:arg name="body_x"                default="0.70"/>
  <xacro:arg name="body_y"                default="0.31"/>
  <xacro:arg name="body_z"                default="0.20"/>
  <xacro:arg name="body_mass"             default="12.0"/>
  <xacro:arg name="hip_x"                 default="0.28"/>
  <xacro:arg name="hip_y"                 default="0.16"/>
  <xacro:arg name="thigh_len"             default="0.20"/>
  <xacro:arg name="wheel_radius"          default="0.085"/>
  <xacro:arg name="wheel_width"           default="0.05"/>
  <xacro:arg name="sensor_profile"        default="mid360_imu_cam"/>
  <xacro:arg name="use_gimbal"            default="true"/>
  <xacro:arg name="odom_source"           default="gt"/>
  <xacro:arg name="lidar_xyz"             default="0.18 0.0 0.16"/>
  <xacro:arg name="lidar_rpy"             default="0.0 0.0 0.0"/>
  <xacro:arg name="camera_xyz"            default="0.34 0.0 0.06"/>
  <xacro:arg name="camera_rpy"            default="0.0 0.0 0.0"/>
  <xacro:arg name="imu_xyz"               default="0.18 0.0 0.16"/>
  <xacro:arg name="imu_rpy"               default="0.0 0.0 0.0"/>

  <xacro:include filename="$(find robot_descriptions)/xacro/common/materials.xacro"/>
  <xacro:include filename="$(find robot_descriptions)/xacro/common/sensors.xacro"/>
  <xacro:include filename="$(find robot_descriptions)/xacro/common/gazebo_control.xacro"/>

  <!-- ======================== 派生量 ======================== -->
  <xacro:property name="body_x_"       value="$(arg body_x)"/>
  <xacro:property name="body_y_"       value="$(arg body_y)"/>
  <xacro:property name="body_z_"       value="$(arg body_z)"/>
  <xacro:property name="body_mass_"    value="$(arg body_mass)"/>
  <xacro:property name="hip_x_"        value="$(arg hip_x)"/>
  <xacro:property name="hip_y_"        value="$(arg hip_y)"/>
  <xacro:property name="thigh_len_"    value="$(arg thigh_len)"/>
  <xacro:property name="wheel_radius_" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width_"  value="$(arg wheel_width)"/>
  <xacro:property name="profile_"      value="$(arg sensor_profile)"/>
  <xacro:property name="use_gimbal_"   value="$(arg use_gimbal)"/>
  <xacro:property name="odom_source_"  value="$(arg odom_source)"/>

  <!-- 站姿高度由几何推出：轮子触地时 base_link 的高度。
       零位关节角下腿完全伸展，所以这个式子严格成立，不会出现脚穿地。 -->
  <xacro:property name="stand_height_" value="${wheel_radius_ + thigh_len_ + body_z_/2.0}"/>

  <!-- 点云消息的 frame：启用云台则走 lidar_stabilized（节点动态发布）

       注意：这里【不能】写成 use_gimbal_ == 'true'。
       xacro 会把属性值 "true"/"false" 自动转成 Python 布尔，
       所以 use_gimbal_ 是 True 而不是字符串 'true'，比较恒为 False，
       结果就是云台开关静默失效 —— 不报错，只是补偿永远不生效。
       直接用布尔的真值判断即可。 -->
  <xacro:property name="lidar_msg_frame_" value="${'lidar_stabilized' if use_gimbal_ else ''}"/>

  <!-- ======================== 基础链路 ======================== -->
  <!-- base_footprint：地面投影原点，z 恒为 0 -->
  <link name="base_footprint"/>

  <!-- base_link：车体几何中心，离地 stand_height -->
  <link name="base_link">
    <xacro:sim_box_inertia mass="${body_mass_}" size_x="${body_x_}" size_y="${body_y_}" size_z="${body_z_}"/>
    <visual>
      <geometry><box size="${body_x_} ${body_y_} ${body_z_}"/></geometry>
      <material name="sim_light_grey"/>
    </visual>
    <collision>
      <geometry><box size="${body_x_} ${body_y_} ${body_z_}"/></geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${stand_height_}" rpy="0 0 0"/>
  </joint>

  <!-- 朝向指示块：仿真里一眼看出车头方向，调试导航时非常省事 -->
  <link name="heading_marker">
    <xacro:sim_box_inertia mass="0.05" size_x="0.08" size_y="0.12" size_z="0.04"/>
    <visual>
      <geometry><box size="0.08 0.12 0.04"/></geometry>
      <material name="sim_accent"/>
    </visual>
  </link>
  <joint name="heading_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="heading_marker"/>
    <origin xyz="${body_x_/2.0 - 0.04} 0 ${body_z_/2.0 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ======================== 腿：宏 ======================== -->
  <xacro:macro name="wq_leg" params="p fx fy">
    <!-- 髋关节（abduction，绕 x 轴 roll） -->
    <link name="${p}_hip_link">
      <xacro:sim_cylinder_inertia mass="0.45" radius="0.035" length="0.06"/>
      <visual>
        <geometry><cylinder radius="0.035" length="0.06"/></geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <material name="sim_dark_grey"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.035" length="0.06"/></geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      </collision>
    </link>

    <joint name="${p}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${p}_hip_link"/>
      <origin xyz="${fx * hip_x_} ${fy * hip_y_} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.50" upper="0.50" effort="40.0" velocity="20.0"/>
      <dynamics damping="0.8" friction="0.2"/>
    </joint>

    <!-- 大腿 -->
    <link name="${p}_thigh_link">
      <inertial>
        <mass value="0.95"/>
        <origin xyz="0 0 ${-thigh_len_/2.0}" rpy="0 0 0"/>
        <inertia ixx="0.0033" ixy="0" ixz="0" iyy="0.0033" iyz="0" izz="0.0002"/>
      </inertial>
      <visual>
        <geometry><box size="0.055 0.045 ${thigh_len_}"/></geometry>
        <origin xyz="0 0 ${-thigh_len_/2.0}" rpy="0 0 0"/>
        <material name="sim_dark_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.055 0.045 ${thigh_len_}"/></geometry>
        <origin xyz="0 0 ${-thigh_len_/2.0}" rpy="0 0 0"/>
      </collision>
    </link>

    <joint name="${p}_thigh_joint" type="revolute">
      <parent link="${p}_hip_link"/>
      <child link="${p}_thigh_link"/>
      <origin xyz="0 ${fy * 0.045} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.20" upper="2.20" effort="40.0" velocity="20.0"/>
      <dynamics damping="0.8" friction="0.2"/>
    </joint>

    <!-- 轮（continuous 关节，绕 y 轴自转） -->
    <link name="${p}_wheel_link">
      <xacro:sim_cylinder_inertia mass="0.55" radius="${wheel_radius_}" length="${wheel_width_}"/>
      <visual>
        <geometry><cylinder radius="${wheel_radius_}" length="${wheel_width_}"/></geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <material name="sim_sensor_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius_}" length="${wheel_width_}"/></geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      </collision>
    </link>

    <joint name="${p}_wheel_joint" type="continuous">
      <parent link="${p}_thigh_link"/>
      <child link="${p}_wheel_link"/>
      <origin xyz="0 0 ${-thigh_len_}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20.0" velocity="40.0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- 接触参数：轮子给高摩擦，抑制仿真抖动 -->
    <gazebo reference="${p}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <selfCollide>false</selfCollide>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- ======================== 四条腿实例 ======================== -->
  <xacro:wq_leg p="FL" fx="1"  fy="1"/>
  <xacro:wq_leg p="FR" fx="1"  fy="-1"/>
  <xacro:wq_leg p="RL" fx="-1" fy="1"/>
  <xacro:wq_leg p="RR" fx="-1" fy="-1"/>

  <!-- ======================== 传感器 ======================== -->
  <xacro:sim_sensor_suite
    profile="${profile_}"
    lidar_parent="base_link"
    lidar_frame="lidar_link"
    lidar_msg_frame="${lidar_msg_frame_}"
    lidar_xyz="$(arg lidar_xyz)"
    lidar_rpy="$(arg lidar_rpy)"
    camera_xyz="$(arg camera_xyz)"
    camera_rpy="$(arg camera_rpy)"
    imu_xyz="$(arg imu_xyz)"
    imu_rpy="$(arg imu_rpy)"/>

  <!-- ======================== Gazebo 插件 ======================== -->
  <!-- 运动学模式：关重力、冻结 z。
       必须放在 sim_planar_move 之前起效（同一个 <gazebo> 作用域按 reference
       匹配 link，顺序无关，但先声明可读性更好）。
       详见 common/gazebo_control.xacro 里该宏的长注释。 -->
  <xacro:sim_kinematic_freeze link_name="base_footprint"/>

  <xacro:sim_planar_move odom_source="${odom_source_}"/>
  <xacro:sim_ground_truth_odom/>

</robot>
