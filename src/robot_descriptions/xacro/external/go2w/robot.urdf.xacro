<?xml version="1.0"?>
<robot name="sim_go2w" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- =========================================================================
       宇树 Go2W（轮足式机器狗）—— 开源 URDF 导入模板
       =========================================================================
       上游模型：https://github.com/unitreerobotics/unitree_ros
                 robots/go2w_description/urdf/go2w_description.urdf
       许可：BSD-3-Clause（宇树官方开源仓库）

       为什么需要这个 wrapper 而不是直接用上游 URDF：
         上游 URDF 是【纯描述文件】—— 只有 link/joint 的几何、惯量、mesh，
         **没有任何 Gazebo 插件**。直接 spawn 到 Gazebo 里，它会：
           - 没有驱动（planar_move / diff_drive），机器人一动不动
           - 没有传感器，/points /imu 一概不发布
           - 没有 base_footprint，与 Nav2 约定的 base_frame 对不上
         所以必须把我们的传感器套件 + 驱动插件 + base_footprint 挂上去。
         这正是本项目"参数化描述层"的价值：上游模型照单全收，
         仿真所需的东西由我们注入，换机器人不用改算法侧一行代码。

       上游模型的关节命名（与本模板的接口约定）：
         base                                   车体根 link
         {FL,FR,RL,RR}_hip / _thigh / _calf     腿关节
         {FL,FR,RL,RR}_foot                     轮（continuous 关节）

       注意 z 轴朝向：上游 URDF 的关节轴与仿真里常见约定一致
       （hip 绕 x、thigh 绕 y、calf 绕 y、wheel 绕 y），
       无需额外 rpy 修正。若上游版本改了轴，改下面的 axis 即可。

       使用前置：需先把上游 go2w_description 放到 src/ 下并编译，
                 或在 xacro arg 里指定 go2w_urdf 为绝对路径。
       ========================================================================= -->

  <!-- ======================== 参数入口 ======================== -->
  <xacro:arg name="robot_name"      default="go2w"/>
  <!-- 上游 URDF 的路径。默认按包查找；也可传绝对路径 -->
  <xacro:arg name="go2w_urdf"       default="$(find go2w_description)/urdf/go2w_description.urdf"/>
  <!-- 站立高度：轮触地时 base link 的 z 值。
       它不是随手填的数，是从上游 URDF 量出来的：
         base → FL_hip → FL_thigh → FL_calf → FL_foot 各段 origin.z 累加
           hip   0.0000
           thigh 0.0000
           calf  -0.2130
           foot  -0.2264
           ─────────────
           合计  -0.4394 m   （base 到轮心）
         轮半径 0.0860 m（量自 dae 顶点包围盒，x/z 跨度 0.1719 / 2）
         ⇒ stand_height = 0.4394 + 0.0860 = 0.5254 m
       四条腿实测一致（FL/FR/RL/RR 均为 -0.4394），不存在偏腿。

       ⚠️ 曾经的错误值 0.316 会少算 0.2094 m：模型 spawn 时直接陷进地面，
          轮子与地面互相穿透，接触力把车体往上弹，表现为 z 反复跳变、
          planar_move 推不动 —— 与"被动关节塌陷"的症状极其相似，
          很容易误判成关节问题。改这个数之前先按上面的链路量一遍。 -->
  <xacro:arg name="stand_height"    default="0.5254"/>
  <xacro:arg name="sensor_profile"  default="lidar3d_imu_cam"/>
  <xacro:arg name="use_gimbal"      default="true"/>
  <xacro:arg name="odom_source"     default="gt"/>
  <xacro:arg name="lidar_xyz"       default="0.0 0.0 0.14"/>
  <xacro:arg name="lidar_rpy"       default="0.0 0.0 0.0"/>
  <xacro:arg name="camera_xyz"      default="0.20 0.0 0.04"/>
  <xacro:arg name="camera_rpy"      default="0.0 0.0 0.0"/>
  <xacro:arg name="imu_xyz"         default="0.0 0.0 0.14"/>
  <xacro:arg name="imu_rpy"         default="0.0 0.0 0.0"/>

  <xacro:include filename="$(find robot_descriptions)/xacro/common/materials.xacro"/>
  <xacro:include filename="$(find robot_descriptions)/xacro/common/sensors.xacro"/>
  <xacro:include filename="$(find robot_descriptions)/xacro/common/gazebo_control.xacro"/>

  <xacro:property name="profile_"     value="$(arg sensor_profile)"/>
  <xacro:property name="use_gimbal_"  value="$(arg use_gimbal)"/>
  <xacro:property name="odom_source_" value="$(arg odom_source)"/>
  <xacro:property name="stand_h_"     value="$(arg stand_height)"/>

  <!-- 云台传感器 frame 选择（同 wheeled_quadruped，不要写成 == 'true'） -->
  <xacro:property name="lidar_msg_frame_" value="${'lidar_stabilized' if use_gimbal_ else ''}"/>

  <!-- ======================== 1. 导入上游模型 ======================== -->
  <!-- xacro 的 include 会把上游 URDF 的全部 link/joint 并到本文件里。
       上游文件本身是合法的 xacro（无 xacro 标签的纯 URDF 也能被 include）。 -->
  <xacro:include filename="$(arg go2w_urdf)"/>

  <!-- ======================== 2. 补 base_footprint 根 + base_link 别名 ======================== -->
  <!-- Nav2 的 robot_base_frame 约定用 base_footprint（地面投影，z=0）。
       上游 URDF 的根是 base（车体中心），所以加一个固定关节把它吊到地面。 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base"/>
    <origin xyz="0 0 ${stand_h_}" rpy="0 0 0"/>
  </joint>

  <!-- base_link 别名：
       sensors.xacro 里的 IMU 与深度相机宏把父 link 写死为 "base_link"
       （因为本平台自研模型的根就是 base_link）。上游 Go2W 用的是 "base"，
       直接调用会得到一个指向不存在 link 的关节 —— xacro 不报错，
       但 Gazebo 加载时传感器会被静默丢弃。
       用空质量固定关节把两者接起来，既不改公共宏，也不用改上游 URDF。 -->
  <link name="base_link"/>
  <joint name="base_link_alias_joint" type="fixed">
    <parent link="base"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ======================== 3. 传感器注入 ======================== -->
  <!-- 挂到 base（上游车体 link），由 sensor_profile 决定挂哪些 -->
  <xacro:sim_sensor_suite
    profile="${profile_}"
    lidar_parent="base"
    lidar_frame="lidar_link"
    lidar_msg_frame="${lidar_msg_frame_}"
    lidar_xyz="$(arg lidar_xyz)"
    lidar_rpy="$(arg lidar_rpy)"
    camera_xyz="$(arg camera_xyz)"
    camera_rpy="$(arg camera_rpy)"
    imu_xyz="$(arg imu_xyz)"
    imu_joint_name="sim_imu_mount_joint"
    imu_rpy="$(arg imu_rpy)"/>

  <!-- ======================== 4. 驱动插件注入 ======================== -->
  <!-- 上游 URDF 无任何 gazebo 插件，这里补上平面运动 + 真值里程计。
       注意：planar_move 是"贴地滑行"驱动，腿/轮的关节不会被真正驱动。
       对本平台的用途（建图/导航算法评测）这是【有意为之】：
       我们要评的是 SLAM/Nav2，不是足式步态控制；贴地驱动能保证轨迹
       完全可控可复现，消除步态引入的抖动作为混淆变量。
       真要做步态验证，改用 ros2_control 插件并替换本段。 -->
  <!-- 运动学模式：关重力、冻结 z（否则 z 会在下塌与弹回之间反复跳，见宏注释） -->
  <xacro:sim_kinematic_freeze link_name="base_footprint"/>
  <xacro:sim_planar_move odom_source="${odom_source_}"/>
  <xacro:sim_ground_truth_odom/>

</robot>
