<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================================
       Gazebo 插件层：运动驱动 + 真值里程计
       =========================================================================
       设计取舍（很重要，直接影响测试能测到什么）：

       本项目默认用 gazebo_ros_planar_move 驱动底盘 —— 它直接接受 /cmd_vel、
       输出 /odom，不需要任何步态控制器。对于"测建图/导航算法"这个目标，
       这是最省事且最不引入无关噪声的做法。

       代价：底盘运动是理想化的平面运动，没有打滑。
       所以：
         - 测的是「建图/导航算法本身」在里程计不完美（LIO 有真实漂移）时的表现
         - 不测「腿式运动学/接触打滑对建图的影响」

       如果你要测后者，把 sim_planar_move 换成 sim_diff_drive_drive_wheels
       （仅轮式/轮足可用），让物理通过轮子接触驱动机器人，就会出现真实打滑。
       ========================================================================= -->

  <!-- =========================================================================
       平面运动驱动（默认）
       =========================================================================
       ⚠️ 与 sim_kinematic_freeze 配套使用（见下方），否则 z 会失控。
       ========================================================================= -->
  <xacro:macro name="sim_planar_move"
    params="odom_source
            cmd_topic:=cmd_vel
            odom_topic:=odom
            odometry_frame:=odom
            robot_base_frame:=base_footprint
            update_rate:=100.0">

    <!-- 只有当 odom_source=gt 时，planar_move 才发布 odom->base_footprint TF。
         当 odom_source=lio 时，TF 必须交给 LIO 发布，否则 TF 树会出现双父节点。 -->
    <xacro:property name="pm_publish_tf" value="${odom_source == 'gt'}"/>

    <gazebo>
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <command_topic>${cmd_topic}</command_topic>
        <odometry_topic>${odom_topic}</odometry_topic>
        <odometry_frame>${odometry_frame}</odometry_frame>
        <robot_base_frame>${robot_base_frame}</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>${pm_publish_tf}</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <update_rate>${update_rate}</update_rate>
      </plugin>
    </gazebo>
  </xacro:macro>


  <!-- =========================================================================
       运动学模式：关重力 + 冻结 z
       =========================================================================
       为什么必须做这件事（实测踩过的坑，务必保留这段说明）：

       gazebo_ros_planar_move 是【运动学】插件，它每帧直接把模型 pose 的
       x / y / yaw 写成指令积分值，但【完全不碰 z】。于是 z 归物理引擎管。

       而刚性化后的机器人在物理上是"一坨刚体 + 一圈碰撞体"：
         - 重力把它往下拉
         - 轮子碰撞体触地后又被弹起
         - 中间还会因为穿透修正产生抖动
       实测 /odom 的 z 轨迹：
           0.435（spawn）→ -0.2275（一路塌下去）
           → -0.1000（轮底触地的稳态）
           → +0.3848（突然被弹回 URDF 标称站姿）

       z 这样反复跳变的后果：
         1. 雷达高度漂移，points_to_scan 的高度带切出来的扫描几何前后不一致
         2. 真值里程计（p3d）报的高度也跟着跳，评测基准不可信
         3. 底盘"推不动"——planar_move 写的姿态与接触约束互相打架

       关掉重力的效果：模型不再受重力，也没有接触力，planar_move 成为唯一
       的位姿来源。z 恒定等于 spawn 高度，x/y/yaw 完全可控、可复现。

       代价（与项目既定的取舍一致）：不再仿真真实的地面接触与打滑。
       这正是我们要的——本项目测的是建图/导航算法，不是轮胎摩擦。
       要恢复真实物理，把 sim_kinematic_freeze 去掉，并给关节挂真正的
       力矩控制器 + 关掉 rigid_joints。
       ========================================================================= -->
  <xacro:macro name="sim_kinematic_freeze" params="link_name:=base_footprint">
    <gazebo>
      <plugin name="sim_planar_constraint"
              filename="$(find robot_descriptions)/../../lib/libsim_planar_constraint.so"/>
      <plugin name="sim_contact_monitor"
              filename="$(find robot_descriptions)/../../lib/libsim_contact_monitor.so"/>
    </gazebo>
    <gazebo reference="${link_name}">
      <gravity>false</gravity>
      <selfCollide>false</selfCollide>
      <!-- 关掉与地面的所有接触：没有接触就没有法向力的抖动 -->
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>0.0</kp>
      <kd>0.0</kd>
      <minDepth>0.0</minDepth>
      <maxVel>0.0</maxVel>
    </gazebo>
  </xacro:macro>


  <!-- =========================================================================
       真值里程计（评测用，始终发布）
       ==========================================================================
       永远发布在 /ground_truth/odom，算法不得消费。

       ⚠️ body_name 必须是 base_footprint，不能写 base_link。
       Gazebo 的 URDF->SDF 转换会把固定关节"合并"掉：base_footprint 是根 link，
       base_link 通过 base_joint（fixed）挂在它下面，于是 base_link 被并进
       base_footprint，SDF 里根本不存在名为 base_link 的 link。
       写 base_link 会得到：
         [ERROR] [ground_truth_odom]: body_name: base_link does not exist
       然后真值里程计【静默地什么都不发】—— 仿真看着一切正常，但评测没有基准。

       合并后 base_footprint 承载了 base_link 的质量与惯量，所以 p3d 能正常用它。
       ========================================================================= -->
  <xacro:macro name="sim_ground_truth_odom"
    params="topic:=ground_truth/odom
            body_name:=base_footprint
            frame_name:=odom
            update_rate:=200.0">

    <gazebo>
      <plugin name="ground_truth_odom" filename="libgazebo_ros_p3d.so">
        <ros>
          <namespace>/</namespace>
          <remapping>odom:=${topic}</remapping>
        </ros>
        <body_name>${body_name}</body_name>
        <frame_name>${frame_name}</frame_name>
        <update_rate>${update_rate}</update_rate>
        <gaussian_noise>0.0</gaussian_noise>
      </plugin>
    </gazebo>
  </xacro:macro>


  <!-- =========================================================================
       可选：轮式差速驱动（含真实打滑）
       =========================================================================
       需要 joint 名匹配。仅当你想测"接触打滑对建图/里程计的影响"时启用，
       并同时关掉 sim_planar_move。

       未默认启用。启用方式：在机器人 xacro 里把 sim_planar_move 调用换成
       本宏，并把 wheel_joint 名填对。
       ========================================================================= -->
  <xacro:macro name="sim_diff_drive_drive_wheels"
    params="left_joint right_joint
            wheel_separation wheel_diameter
            odom_source
            cmd_topic:=cmd_vel
            odom_topic:=odom
            odometry_frame:=odom
            robot_base_frame:=base_footprint
            update_rate:=100.0
            max_wheel_torque:=20.0
            max_wheel_accel:=5.0">

    <xacro:property name="dd_publish_tf" value="${odom_source == 'gt'}"/>

    <gazebo>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <update_rate>${update_rate}</update_rate>
        <left_joint>${left_joint}</left_joint>
        <right_joint>${right_joint}</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_diameter>${wheel_diameter}</wheel_diameter>
        <max_wheel_torque>${max_wheel_torque}</max_wheel_torque>
        <max_wheel_acceleration>${max_wheel_accel}</max_wheel_acceleration>
        <command_topic>${cmd_topic}</command_topic>
        <odometry_topic>${odom_topic}</odometry_topic>
        <odometry_frame>${odometry_frame}</odometry_frame>
        <robot_base_frame>${robot_base_frame}</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>${dd_publish_tf}</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
      </plugin>
    </gazebo>
  </xacro:macro>


  <!-- =========================================================================
       物理参数调优：提高腿部接触稳定性，减少仿真抖动
       =========================================================================
       腿式平台在 Gazebo 里默认参数下容易"抖脚"，表现为躯干高频小幅振动，
       这会直接污染雷达点云、让 LIO 误以为在运动。这里给接触参数上阻尼。
       ========================================================================= -->
  <xacro:macro name="sim_contact_params" params="link_name foot_radius">
    <gazebo reference="${link_name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.01</maxVel>
      <selfCollide>false</selfCollide>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

</robot>
